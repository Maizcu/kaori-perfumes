{%- assign variant = product.variants.first -%}

<label class="ritual-option">
  <input
    class="visually-hidden"
    type="checkbox"
    value="{{ variant.id }}"
    data-title="{{ product.title | escape }}{% if format != blank %} · {{ format | escape }}{% endif %}"
    data-price="{{ variant.price }}"
  >
  <span class="ritual-option__media">
    {%- if product.featured_image -%}
      {{
        product.featured_image
        | image_url: width: 600
        | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 20vw, 45vw', alt: ''
      }}
    {%- endif -%}
    <span class="ritual-option__check" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
  </span>
  <span class="ritual-option__name">{{ product.title | escape }}</span>
  <span class="ritual-option__price">
    {%- if format != blank %}{{ format | escape }} · {% endif -%}
    {{- variant.price | money_without_trailing_zeros -}}
  </span>
</label>
