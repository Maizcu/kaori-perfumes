{{ 'section-story-teaser.css' | asset_url | stylesheet_tag }}

<div class="story page-width">
  {%- if section.settings.image_left != blank -%}
    {{
      section.settings.image_left
      | image_url: width: 700
      | image_tag:
        class: 'story__image story__image--left',
        alt: '',
        loading: 'lazy',
        widths: '300, 500, 700',
        sizes: '20vw'
    }}
  {%- endif -%}

  <div class="story__content">
    {%- if section.settings.stamp != blank -%}
      <span class="stamp" lang="ja" aria-hidden="true">{{ section.settings.stamp | escape }}</span>
    {%- endif -%}

    {%- if section.settings.label != blank -%}
      <p class="eyebrow">{{ section.settings.label | escape }}</p>
    {%- endif -%}

    <h2 class="story__title">{{ section.settings.title }}</h2>

    {%- if section.settings.text != blank -%}
      <p class="story__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.link_label != blank -%}
      <a
        {% if section.settings.link == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ section.settings.link }}"
        {% endif %}
        class="text-link"
      >
        {{- section.settings.link_label | escape -}}
        {{ 'icon-arrow.svg' | inline_asset_content }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.image_right != blank -%}
    {{
      section.settings.image_right
      | image_url: width: 800
      | image_tag:
        class: 'story__image story__image--right',
        alt: '',
        loading: 'lazy',
        widths: '300, 500, 800',
        sizes: '22vw'
    }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Nuestra historia",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Imagen izquierda"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Imagen derecha"
    },
    {
      "type": "text",
      "id": "stamp",
      "label": "Sello",
      "default": "香"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Antetítulo",
      "default": "Nuestra historia · La leyenda de Kaori"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Un aroma puede <em>devolverte a un lugar.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Cuentan que una vieja perfumista guardaba en su jardín cinco tesoros: una granada, un cerezo que florecía de noche, un coco traído por el mar, una lágrima de ámbar y un viejo sándalo. De ellos nacen nuestros cinco perfumes."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Leer la leyenda"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Nuestra historia"
    }
  ]
}
{% endschema %}
