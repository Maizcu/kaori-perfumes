{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-candles.css' | asset_url | stylesheet_tag }}

<div class="candles page-width">
  <div class="candles__content">
    {%- if section.settings.label != blank -%}
      <p class="eyebrow">{{ section.settings.label | escape }}</p>
    {%- endif -%}

    <h2 class="candles__title">{{ section.settings.title }}</h2>

    {%- if section.settings.text != blank -%}
      <p class="candles__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.collection.url }}" class="text-link">
        {{- section.settings.link_label | escape -}}
        {{ 'icon-arrow.svg' | inline_asset_content }}
      </a>
    {%- endif -%}

    <ul class="candles__list grid grid--3-col" role="list">
      {%- for product in section.settings.collection.products limit: 3 -%}
        <li class="grid__item">
          {% render 'card-product', card_product: product, media_aspect_ratio: 'portrait', section_id: section.id %}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="candles__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw'
      }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Velas destacadas",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Antetítulo",
      "default": "Las velas"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Para encender <em>el momento</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Formas escultóricas y cera en colores suaves. Encendidas o apagadas, también decoran."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "Ver todas las velas"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    }
  ],
  "presets": [
    {
      "name": "Velas destacadas"
    }
  ]
}
{% endschema %}